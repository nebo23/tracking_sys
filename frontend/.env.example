# Copy to .env.local to change a setting. These values are public: they are compiled into the
# bundle that every visitor downloads. Never put a secret here.

# Origin of the API. The API must list this application's origin in TRACKING_ALLOWED_ORIGINS.
VITE_API_ORIGIN=http://127.0.0.1:8000

# Set to true only when the API has TRACKING_GOOGLE_SIGN_IN_ENABLED=true.
VITE_GOOGLE_SIGN_IN=false

# Set to true only for local development against an API that has TRACKING_CONNECTOR_SYNTHETIC_STATE
# set. It lists the stand-in providers, which contact nobody, when connecting an account.
VITE_SYNTHETIC_PROVIDERS=false

# Origin of the short links that are not on a custom domain: one of the API's
# TRACKING_LINK_PLATFORM_HOSTS, with its scheme. Leave it out to use VITE_API_ORIGIN.
# VITE_SHORT_LINK_ORIGIN=https://go.connect.example
