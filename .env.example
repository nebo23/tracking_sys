# Native PostgreSQL development connection. Copy to .env.
# Provision the project roles and enter their actual passwords here.
# Use single-quoted values when passwords contain #, $ or whitespace.
# Never commit .env. The optional container stack uses .env.docker instead.
TRACKING_DATABASE_HOST=127.0.0.1
TRACKING_DATABASE_PORT=5432
TRACKING_DATABASE_NAME=tracking_sys
TRACKING_DATABASE_USER=tracking_app
TRACKING_DATABASE_PASSWORD=
TRACKING_MIGRATION_USER=tracking_migrator
TRACKING_MIGRATION_PASSWORD=
# Lifecycle runner role (D-024), created with infra/postgres/lifecycle-role.sql.
TRACKING_LIFECYCLE_USER=tracking_lifecycle
TRACKING_LIFECYCLE_PASSWORD=
TRACKING_API_PORT=8000
# Independent application keys; generate using the local setup guide.
TRACKING_AUTH_SECRET=
TRACKING_MAIL_ENCRYPTION_KEY=
TRACKING_COOKIE_SECURE=false

# Google sign-in (D-022). Use the Web application client whose authorized redirect
# URI matches TRACKING_GOOGLE_REDIRECT_URI exactly. TRACKING_GOOGLE_COMPLETE_URL
# receives the browser after the callback and must use an allowed origin; use
# http://127.0.0.1:8000/docs for a local test without the React application, or
# leave it blank for the frontend default.
TRACKING_GOOGLE_SIGN_IN_ENABLED=false
TRACKING_GOOGLE_CLIENT_ID=
TRACKING_GOOGLE_CLIENT_SECRET=
TRACKING_GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
TRACKING_GOOGLE_COMPLETE_URL=

# Gmail sender (D-022): a separate Desktop OAuth client, never the sign-in client.
# Run python -m app.gmail_authorize to store the refresh token, then set the sender
# address and TRACKING_MAIL_MODE=gmail. Local .eml capture remains the default.
TRACKING_MAIL_MODE=local
TRACKING_GMAIL_CLIENT_ID=
TRACKING_GMAIL_CLIENT_SECRET=
TRACKING_GMAIL_REFRESH_TOKEN=
TRACKING_GMAIL_SENDER=

# Numeric verification key: at least 32 random bytes in hexadecimal, generated as in
# the authentication guide. It must differ from TRACKING_AUTH_SECRET and from every
# Google secret.
TRACKING_OTP_SECRET=

# Event collection keyrings (D-027), development only; see docs/engineering/event-collection.md.
# Token keyring "id:base64url" seals webhook signing secrets (D-025 local custody). Tombstone
# keyring "id:hex" keys erasure tombstones; add keys, never remove one that tombstones use.
# Collection routes answer 503 collection_not_configured while a needed keyring is blank.
TRACKING_TOKEN_KEYRING=
TRACKING_TOKEN_KEYRING_ACTIVE=
TRACKING_TOMBSTONE_KEYRING=
TRACKING_TOMBSTONE_KEYRING_ACTIVE=

# Connector runtime (D-048); see docs/engineering/connectors.md. The synthetic provider is
# development only and selected solely by its state file, shared by the API and
# python -m app.connector_worker. Connectors also need the token keyring above.
TRACKING_CONNECTOR_SYNTHETIC_STATE=
TRACKING_CONNECTOR_REDIRECT_URI=http://127.0.0.1:8000/connectors/oauth/callback
TRACKING_CONNECTOR_COMPLETE_URL=
# Synchronization (009-B): scheduling interval and per-connection daily units (synthetic).
TRACKING_CONNECTOR_SYNC_INTERVAL_HOURS=24
TRACKING_CONNECTOR_CONNECTION_DAILY_UNITS=100
# Live Instagram Login adapter (010-C, D-055): off unless enabled with the Meta app's ID
# and secret, and registered only while its provider rules are current. Keep the secret
# only in the ignored .env; the 010-B feasibility tool reads the same two values.
TRACKING_CONNECTOR_INSTAGRAM_ENABLED=false
TRACKING_INSTAGRAM_APP_ID=
TRACKING_INSTAGRAM_APP_SECRET=
# Live YouTube adapter (011-C, D-060): off unless enabled with the connector's own Google Web
# client, never the sign-in or Gmail sender client, and registered only while its provider
# rules are current. Keep the secret only in the ignored .env; the 011-B feasibility tool reads
# the same two values. Switching it off is the kill switch: run the operator purge within 30
# days (docs/engineering/connectors.md).
TRACKING_CONNECTOR_YOUTUBE_ENABLED=false
TRACKING_YOUTUBE_CLIENT_ID=
TRACKING_YOUTUBE_CLIENT_SECRET=
# Live Meta advertising adapters meta_ads and meta_capi (014-D, D-064): off unless enabled
# with their own Meta app ID, app secret and Facebook Login for Business configuration ID,
# separate from the Instagram values, and registered only while their provider rules are
# current. Keep the secret only in the ignored .env. Spec 014 makes no live Meta call.
TRACKING_CONNECTOR_META_ADS_ENABLED=false
TRACKING_META_ADS_APP_ID=
TRACKING_META_ADS_APP_SECRET=
TRACKING_META_ADS_CONFIG_ID=
# Paymob payment sources (015-B, D-067): off unless enabled, and usable only while the
# payments.processor_records and paymob.accept provider rules are current. Merchant HMAC
# secrets are entered through the API and sealed under the token keyring, never kept here.
# Spec 015 makes no call to Paymob; live callbacks need HTTPS hosting (020).
TRACKING_PAYMENTS_PAYMOB_ENABLED=false
# Booking and CRM integration sources (015-D, D-068): the Cal.com kind and the
# provider-neutral signed webhook kind stay off unless enabled. Signing secrets are entered
# or issued through the API and sealed under the token keyring, never kept here.
TRACKING_INTEGRATIONS_CALCOM_ENABLED=false
TRACKING_INTEGRATIONS_WEBHOOK_ENABLED=false

# Managed links and custom domains (D-033); see docs/engineering/links-and-tracker.md.
# Platform short-link authorities as a JSON list of exact host:port values (no wildcards).
# Loopback destinations are for local development only. Live DNS/TLS domain verification
# stays disabled unless explicitly enabled with the operator's CNAME service target.
TRACKING_LINK_PLATFORM_HOSTS='["127.0.0.1:8000","localhost:8000"]'
TRACKING_LINK_ALLOW_LOOPBACK_DESTINATIONS=false
TRACKING_LINK_CUSTOM_DOMAIN_PORT=443
TRACKING_LINK_SERVICE_TARGET=
TRACKING_LINK_DOMAIN_VERIFICATION=disabled
TRACKING_CONSENT_STATE_PER_MINUTE=60
