# Native PostgreSQL development connection. Copy to .env.
# Provision the project roles and enter their actual passwords here.
# Use single-quoted values when passwords contain #, $ or whitespace.
# Never commit .env. The optional container stack uses .env.docker instead.
TRACKING_DATABASE_HOST=127.0.0.1
TRACKING_DATABASE_PORT=5432
TRACKING_DATABASE_NAME=tracking_sys
TRACKING_DATABASE_USER=tracking_app
TRACKING_DATABASE_PASSWORD=
TRACKING_MIGRATION_USER=tracking_migrator
TRACKING_MIGRATION_PASSWORD=
TRACKING_API_PORT=8000
# Independent application keys; generate using the local setup guide.
TRACKING_AUTH_SECRET=
TRACKING_MAIL_ENCRYPTION_KEY=
TRACKING_COOKIE_SECURE=false
