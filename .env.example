# Native PostgreSQL development connection. Copy to .env.
# Provision the project roles and enter their actual passwords here.
# Use single-quoted values when passwords contain #, $ or whitespace.
# Never commit .env. The optional container stack uses .env.docker instead.
TRACKING_DATABASE_HOST=127.0.0.1
TRACKING_DATABASE_PORT=5432
TRACKING_DATABASE_NAME=tracking_sys
TRACKING_DATABASE_USER=tracking_app
TRACKING_DATABASE_PASSWORD=
TRACKING_MIGRATION_USER=tracking_migrator
TRACKING_MIGRATION_PASSWORD=
# Lifecycle runner role (D-024), created with infra/postgres/lifecycle-role.sql.
TRACKING_LIFECYCLE_USER=tracking_lifecycle
TRACKING_LIFECYCLE_PASSWORD=
TRACKING_API_PORT=8000
# Independent application keys; generate using the local setup guide.
TRACKING_AUTH_SECRET=
TRACKING_MAIL_ENCRYPTION_KEY=
TRACKING_COOKIE_SECURE=false

# Google sign-in (D-022). Use the Web application client whose authorized redirect
# URI matches TRACKING_GOOGLE_REDIRECT_URI exactly. TRACKING_GOOGLE_COMPLETE_URL
# receives the browser after the callback and must use an allowed origin; use
# http://127.0.0.1:8000/docs for a local test without the React application, or
# leave it blank for the frontend default.
TRACKING_GOOGLE_SIGN_IN_ENABLED=false
TRACKING_GOOGLE_CLIENT_ID=
TRACKING_GOOGLE_CLIENT_SECRET=
TRACKING_GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
TRACKING_GOOGLE_COMPLETE_URL=

# Gmail sender (D-022): a separate Desktop OAuth client, never the sign-in client.
# Run python -m app.gmail_authorize to store the refresh token, then set the sender
# address and TRACKING_MAIL_MODE=gmail. Local .eml capture remains the default.
TRACKING_MAIL_MODE=local
TRACKING_GMAIL_CLIENT_ID=
TRACKING_GMAIL_CLIENT_SECRET=
TRACKING_GMAIL_REFRESH_TOKEN=
TRACKING_GMAIL_SENDER=

# Numeric verification key: at least 32 random bytes in hexadecimal, generated as in
# the authentication guide. It must differ from TRACKING_AUTH_SECRET and from every
# Google secret.
TRACKING_OTP_SECRET=
