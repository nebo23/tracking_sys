# Optional self-contained Docker stack. Copy to .env.docker and set passwords.
# Existing volumes retain their original credentials.
TRACKING_DATABASE_HOST=127.0.0.1
TRACKING_DATABASE_PORT=55432
TRACKING_DATABASE_NAME=tracking_local
TRACKING_DATABASE_USER=tracking_app
TRACKING_DATABASE_PASSWORD=
TRACKING_MIGRATION_USER=tracking_migrator
TRACKING_MIGRATION_PASSWORD=
TRACKING_POSTGRES_PASSWORD=
TRACKING_API_PORT=8000
TRACKING_AUTH_SECRET=
TRACKING_MAIL_ENCRYPTION_KEY=
TRACKING_COOKIE_SECURE=false
# Independent numeric-verification key (64 hexadecimal characters); generate privately.
TRACKING_OTP_SECRET=
# Optional Google sign-in and Gmail sender values; see docs/engineering/authentication.md.
# Keep TRACKING_GOOGLE_SIGN_IN_ENABLED=false and TRACKING_MAIL_MODE=local until configured.
# Browser origins forwarded to the API and mail worker. Leave unset to allow the published
# API port on 127.0.0.1/localhost and the local frontend on 5173. When set, provide the
# complete JSON list (single-quoted), for example:
# TRACKING_ALLOWED_ORIGINS='["http://127.0.0.1:18002","http://127.0.0.1:5173"]'
# TRACKING_FRONTEND_ORIGIN=http://127.0.0.1:5173
